{
  "name": "hikka-features",
  "version": "3.2.0",
  "private": true,
  "description": "Універсальне розширення для hikka.io",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "api:generate": "bun scripts/convex-api.mjs",
    "check:api": "bun scripts/convex-api.mjs --check",
    "check:contract": "tsc -p tests/contract/tsconfig.json",
    "postinstall": "wxt prepare",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/eb-garamond": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource-variable/nunito-sans": "^5.3.0",
    "@fontsource-variable/roboto": "^5.3.0",
    "@tanstack/react-query": "^5.108.4",
    "@tanstack/react-virtual": "^3.14.28",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "convex": "^1.51.0",
    "dompurify": "^3.5.0",
    "embla-carousel-react": "^8.6.0",
    "embla-carousel-wheel-gestures": "^8.1.0",
    "html-react-parser": "^6.1.10",
    "ky": "^2.2.0",
    "lucide-react": "^1.81.0",
    "marked": "^18.3.0",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.1",
    "tailwind-gradient-mask-image": "^1.2.0",
    "tailwindcss-animate": "^1.0.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@iconify-json/material-symbols": "^1.2.101",
    "@iconify-json/mdi": "^1.2.3",
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@wxt-dev/auto-icons": "^2.0.0",
    "oxc-transform-react": "~0.156.0",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "oxlint-tsgolint": "^7.0.2009",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "unplugin-icons": "^24.0.0",
    "vite": "8.4.0",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.5"
  }
}
